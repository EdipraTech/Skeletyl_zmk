#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// The default keymap is roughly on Miryoku layout
// (https://github.com/manna-harbour/miryoku).
// Customize on your own on the config folder.

#define BASE    0
#define ALT     1
#define NUM     2
#define SYM     3
#define NAV     4
#define MED     5

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <300>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <0>;      // 0
            time-to-max-speed-ms = <40>;      // 500
            delay-ms = <0>;                   // 10
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp Q       &kp W       &kp F       &kp P         &kp B          &kp J    &kp L       &kp U       &kp Y           &kp SEMI
    &ht LGUI A  &ht LALT R  &ht LCTRL S &ht LSHFT T   &kp G          &kp M    &ht LSHFT N &ht LCTRL E &ht RALT I      &ht LGUI O
    &kp Z       &kp X       &kp C       &kp D         &kp V          &kp K    &kp H       &kp COMMA   &kp DOT         &kp FSLH
                            &lt MED DEL &lt NAV BSPC  &kp ALT        &kp TAB  &lt NUM SPACE   &lt SYM RET
            >;
        };

    alt_layer {
             bindings = <
&kp Q       &kp W       &kp E       &kp R        &kp T                      &kp Y           &kp U       &kp I       &kp O           &kp P
&ht LGUI A  &ht LALT S  &ht LCTRL D &ht LSHFT F  &kp G                      &kp H           &ht RSHFT J &ht RCTRL K &ht RALT L      &ht LGUI SEMI
&kp Z       &kp X       &kp C       &kp V        &kp B                      &kp N           &kp M       &kp COMMA   &kp DOT         &kp FSLH
                        &lt MED DEL &lt NAV BSPC  &kp ALT        &kp TAB  &lt NUM SPACE   &lt SYM RET
            >;
        };

        num_layer {
            bindings = <
&kp F12         &kp F7       &kp F8        &kp F9          &kp RBRC                      &kp ASTRK  &kp N7        &kp N8        &kp N9       &kp FSLH
&ht LGUI F11    &ht LALT F4  &ht LCTRL F5  &ht LSHFT F6    &kp PLUS                      &kp EQUAL  &ht RSHFT N4  &ht RCTRL N5  &ht RALT N6  &ht RGUI PLUS
&kp F10         &kp F1       &kp F2        &kp F3          &kp TAB                       &kp BSLH   &kp N1        &kp N2        &kp N3       &kp MINUS
                             &kp LPAR      &kp RPAR        &kp N0                        &none      &trans        &kp N0     
            >;
        };

        sym_layer {
            bindings = <
&kp CAPS   &kp ESC    &kp LBKT   &kp LBRC   &kp LPAR       &kp RPAR   &kp RBRC  &kp RBKT   &kp EQUAL  &kp PLUS
&kp COLON  &kp GRAVE  &kp EXCL   &kp PIPE   &kp PLUS       &kp ASTRK  &kp DLLR  &kp PRCNT  &kp CARET  &kp SEMI
&kp TILDE  &kp MINUS  &kp UNDER  &kp COLON  &kp SQT        &kp DQT    &kp SEMI  &kp AT     &kp HASH   &kp BSLH
                      &kp LPAR   &kp RPAR   &none          &none      &none     &trans
            >;
        };

        nav_layer {
            bindings = <
&kp PSCRN  &none     &kp UP    &none      &none            &none      &none       &none        &none   &none
&none      &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP        &kp PG_DN  &kp H       &kp J        &kp K   &kp L
&none      &none     &none     &none      &kp HOME         &kp END    &mkp LCLK   &mkp RCLK    &none   &mkp MCLK
                     &none     &trans     &none            &none      &none       &none
            >;
        };

        media_layer {
            bindings = <
&sys_reset  &none     &none      &none      &bootloader         &bootloader   &to ALT       &to BASE      &none         &sys_reset
&kp LGUI    &kp LALT  &kp LCTRL  &kp LSHFT  &out OUT_USB        &out OUT_BLE  &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT
&none       &none     &none      &none      &bt BT_CLR          &kp C_STOP    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     
                      &trans     &none      &none               &kp C_STOP    &kp C_PP      &kp C_MUTE     
            >;
        };

    /*    fun_layer {
            bindings = <
    &kp F12 &kp F7  &kp F8  &kp F9      &kp PSCRN                           &none   &none       &none       &none       &none
    &kp F11 &kp F4  &kp F5  &kp F6      &kp SLCK                            &none   &kp RSHFT   &kp RCTRL   &kp RALT    &kp RGUI
    &kp F10 &kp F1  &kp F2  &kp F3      &kp PAUSE_BREAK                     &none   &none       &none       &none       &none
                            &kp K_APP   &kp SPACE       &kp TAB     &none   &none   &trans
            >;
        }; */
    };
};
